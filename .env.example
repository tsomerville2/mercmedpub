# Medical Research Agent Environment Configuration

# MCP PubMed Server Configuration
MCP_PUBMED_ENDPOINT=http://localhost:8080

# NCBI API Configuration (required for PubMed access)
# Get your API key from: https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=your_ncbi_api_key_here
NCBI_EMAIL=your_email@example.com

# LLM Configuration
# Supported providers: openai, anthropic, azure
LLM_PROVIDER=openai
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gpt-4

# API Server Configuration
API_BASE_URL=http://localhost:8000
TEST_API_KEY=test-api-key-for-development

# Prefect Configuration
PREFECT_API_URL=http://localhost:4200

# Test Configuration
TEST_TIMEOUT=30

# Logging Configuration
LOG_LEVEL=INFO